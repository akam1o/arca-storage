# Optional environment-only API settings.
#
# Keep secrets out of config.toml. Set ARCA_API_TOKEN here, or provide it
# through a secret manager.
#
# ARCA_API_TOKEN=
#
# For loopback-only development, you may explicitly allow unauthenticated API
# access. Do not enable this when the loopback listener is exposed through a
# reverse proxy, tunnel, or port-forward.
#
# ARCA_ALLOW_UNAUTHENTICATED_LOOPBACK=false
