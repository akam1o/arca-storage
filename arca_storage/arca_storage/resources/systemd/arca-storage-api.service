[Unit]
Description=Arca Storage API
After=network.target

[Service]
Type=simple
Environment=ARCA_CONFIG_PATH=/etc/arca-storage/config.toml
EnvironmentFile=-/etc/arca-storage/api.env
ExecStart=/usr/bin/arca-storage-api
Restart=on-failure
RestartSec=3

# The API orchestrates LVM, network namespaces, cgroups, and Pacemaker.
# Keep the host mount namespace so Ganesha can see API-created mounts.
# Filesystem sandboxing also prevents LVM from writing its metadata backups.
# Retain hardening that does not isolate the mount namespace.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN CAP_MKNOD CAP_SYS_RESOURCE CAP_SETUID CAP_SETGID
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectClock=true
ProtectHostname=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
