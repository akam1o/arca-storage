# Managed by arca
# Template version: {{ template_version }}
# Config version: {{ config_version }}

NFS_CORE_PARAM {
    Protocols = {{ protocols }};
{% if bind_addr %}
    Bind_addr = {{ bind_addr }};
{% endif %}
    NFS_Port = 2049;
    MNT_Port = {{ mountd_port }};
{% if enable_v3 %}
    NLM_Port = {{ nlm_port }};
{% endif %}
}

EXPORT_DEFAULTS {
    Access_Type = None;
    Squash = Root_Squash;
    Anonymous_uid = 65534;
    Anonymous_gid = 65534;
}

{% for exp in exports %}
EXPORT {
    Export_Id = {{ exp.export_id }};
    Path = "{{ exp.path }}";
    Pseudo = "{{ exp.pseudo }}";
    Protocols = {{ protocols }};
    Access_Type = None;
    Squash = {{ exp.squash }};
    SecType = {{ exp.sec_render }};
    CLIENT {
        Clients = {{ exp.client }};
        Access_Type = {{ exp.access }};
    }
    FSAL {
        Name = VFS;
    }
}
{% endfor %}
